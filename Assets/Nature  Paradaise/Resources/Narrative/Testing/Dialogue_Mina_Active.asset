  entryNodeId: start
  nodes:
  - nodeId: start
    speakerOverride: {fileID: 0}
    text: Oh, kamu! Bagaimana pencarian kayunya?
    localizationKey:
    emotion: Happy
    nextNodeId: progress
    commands: []
    choices: []
  - nodeId: progress
    speakerOverride: {fileID: 11400000, guid: fb7fb0570a3d5b142a14b2f38025bf75, type: 2}
    text: Masih aku kumpulkan. Ada saran tempat mencarinya?
    localizationKey:
    emotion: Thinking
    nextNodeId: hint
    commands: []
    choices: []
  - nodeId: hint
    speakerOverride: {fileID: 0}
    text: Coba pohon yang bisa ditebang di sekitar kebun. Gunakan Axe, lalu ambil
      kayu yang jatuh sampai terkumpul 3 Wood.
    localizationKey:
    emotion: Thinking
    nextNodeId: thanks
    commands: []
    choices: []
  - nodeId: thanks
    speakerOverride: {fileID: 11400000, guid: fb7fb0570a3d5b142a14b2f38025bf75, type: 2}
    text: Baik, nanti aku mampir lagi.
    localizationKey:
    emotion: Happy
    nextNodeId: take-care
    commands: []
    choices: []
  - nodeId: take-care
    speakerOverride: {fileID: 0}
    text: Terima kasih sudah membantu. Jangan lupa istirahat juga, ya!
    localizationKey:
    emotion: Happy
    nextNodeId:
    commands: []
    choices: []
