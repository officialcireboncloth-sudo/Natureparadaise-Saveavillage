  counterpartSpeaker: {fileID: 11400000, guid: fc657ef91c63d1242a73b0cefd9f3bb4, type: 2}
  entryNodeId: start
  nodes:
  - nodeId: start
    speakerOverride: {fileID: 0}
    text: Kamu sudah kembali! Bagaimana, kayunya sudah terkumpul?
    localizationKey:
    emotion: Happy
    nextNodeId: report
    commands: []
    choices: []
  - nodeId: report
    speakerOverride: {fileID: 11400000, guid: fb7fb0570a3d5b142a14b2f38025bf75, type: 2}
    text: Sudah, 3 Wood seperti yang kamu minta.
    localizationKey:
    emotion: Happy
    nextNodeId: turn-in
    commands: []
    choices: []
  - nodeId: turn-in
    speakerOverride: {fileID: 0}
    text: Wah, terima kasih! Mau melaporkan hasilnya sekarang?
    localizationKey:
    emotion: Happy
    nextNodeId:
    commands: []
    choices:
    - text: Ya, laporkan (+250 G).
      nextNodeId: reward
      conditions: []
      commands:
      - type: 3
        flagId:
        flagValue: 1
        quest: {fileID: 11400000, guid: dc0e2178f504d0540afbb481f00ef789, type: 2}
        objectiveId:
        amount: 1
        item: {fileID: 0}
        goldAmount: 0
    - text: Nanti dulu.
      nextNodeId: later
      conditions: []
      commands: []
  - nodeId: reward
    speakerOverride: {fileID: 0}
    text: Sekarang aku bisa menyelesaikan rak bibitnya. Ini 250 G untuk bantuanmu.
    localizationKey:
    emotion: Happy
    nextNodeId: player-thanks
    commands: []
    choices: []
  - nodeId: player-thanks
    speakerOverride: {fileID: 11400000, guid: fb7fb0570a3d5b142a14b2f38025bf75, type: 2}
    text: Sama-sama, Mina. Semoga raknya cepat selesai!
    localizationKey:
    emotion: Happy
    nextNodeId:
    commands: []
    choices: []
  - nodeId: later
    speakerOverride: {fileID: 0}
    text: Tentu. Aku ada di sini kalau kamu sudah siap.
    localizationKey:
    emotion: Neutral
    nextNodeId:
    commands: []
    choices: []
