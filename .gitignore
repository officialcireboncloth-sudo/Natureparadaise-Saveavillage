# Only Nature Paradise assets belong to this repository.
# Keep other local asset packs/settings on disk, outside version control.
# Required game dependencies (TMP, URP/Input settings, terrain and used pack assets)
# live inside this folder. Move asset + .meta together to preserve references.
/Assets/*
!/Assets/Nature  Paradaise/
!/Assets/Nature  Paradaise.meta

# Toon Farm vendor demo scenes exceed GitHub's 100 MB per-file limit.
# Keep them locally for reference; game assets and prefabs remain versioned.
/Assets/Nature  Paradaise/Pack/Toon Series/Toon Farm Pack/Scenes/Demo_Gardens.unity
/Assets/Nature  Paradaise/Pack/Toon Series/Toon Farm Pack/Scenes/Demo_Gardens.unity.meta
/Assets/Nature  Paradaise/Pack/Toon Series/Toon Farm Pack/Scenes/Demo_Ranch.unity
/Assets/Nature  Paradaise/Pack/Toon Series/Toon Farm Pack/Scenes/Demo_Ranch.unity.meta
