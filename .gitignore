# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
.vs/

# Local player builds and captured output, not project source dependencies.
/Build/
/Builds/
/MemoryCaptures/
/Recordings/

# Visual Studio / IDE generated files
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs

# Unity package archives
*.unitypackage
*.unitypackage.meta

# Local restore copies created before balance CSV imports.
/BalanceBackups/

# Local art sources, exports, previews and validation workspaces.
# Existing versioned files in these folders remain tracked.
/ArtSource/
# Keep the scanner's canonical editable sources and previews after consolidation.
!/ArtSource/
/ArtSource/*
!/ArtSource/SoilScanner/
/ArtSource/SoilScanner/*
!/ArtSource/SoilScanner/Blender/
!/ArtSource/SoilScanner/Textures/
!/ArtSource/SoilScanner/Scripts/
!/ArtSource/SoilScanner/Previews/
/ArtSource/SoilScanner/Blender/*.blend1
/ArtSource/SoilScanner/Blender/*.blend2
!/ArtSource/FertilizerMaker/
/ArtSource/FertilizerMaker/*
!/ArtSource/FertilizerMaker/Blender/
!/ArtSource/FertilizerMaker/Textures/
!/ArtSource/FertilizerMaker/Scripts/
!/ArtSource/FertilizerMaker/Previews/
/ArtSource/FertilizerMaker/Blender/*.blend1
/ArtSource/FertilizerMaker/Blender/*.blend2
/ArtSource/FertilizerMaker/Textures/*.xcf~
# Keep only the fertilizer icon sources in the existing UI art workspace.
!/ArtSource/UIIcons/
/ArtSource/UIIcons/*
!/ArtSource/UIIcons/export_fertilizer_gimp.py
!/ArtSource/UIIcons/FertilizerMaker_Icons.xcf
!/ArtSource/UIIcons/HandPainted/
/ArtSource/UIIcons/HandPainted/*
!/ArtSource/UIIcons/HandPainted/*.py
!/ArtSource/UIIcons/HandPainted/*.xcf
!/ArtSource/UIIcons/HandPainted/Manifest.json
!/ArtSource/UIIcons/HandPainted/Preview.png
!/ArtSource/UIIcons/HandPainted/RetouchedTools_Preview.png
!/ArtSource/UIIcons/Originals/
/ArtSource/UIIcons/Originals/*
!/ArtSource/UIIcons/Originals/FertilizerMaker_Sheet.png
!/ArtSource/UIIcons/Originals/Milker_Approved.png
/Documentation/

# Only Nature Paradise assets belong to this repository.
# Keep other local asset packs/settings on disk, outside version control.
# Required game dependencies (TMP, URP/Input settings, terrain and used pack assets)
# live inside this folder. Move asset + .meta together to preserve references.
/Assets/*
!/Assets/Nature  Paradaise/
!/Assets/Nature  Paradaise.meta

# Toon Farm vendor demo scenes exceed GitHub's 100 MB per-file limit.
# Keep them locally for reference; game assets and prefabs remain versioned.
/Assets/Nature  Paradaise/Pack/Toon Series/Toon Farm Pack/Scenes/Demo_Gardens.unity
/Assets/Nature  Paradaise/Pack/Toon Series/Toon Farm Pack/Scenes/Demo_Gardens.unity.meta
/Assets/Nature  Paradaise/Pack/Toon Series/Toon Farm Pack/Scenes/Demo_Ranch.unity
/Assets/Nature  Paradaise/Pack/Toon Series/Toon Farm Pack/Scenes/Demo_Ranch.unity.meta
